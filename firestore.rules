rules_version = '2';
// One rules file for both apps in this repo: the ONLINE SHOP (/) and the DAY END SHEET (/eod).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin list: users/{uid} with role "admin". Only admins can change it.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Shop name, logo, contact, bank accounts: everyone reads, admin writes
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: everyone reads, admin writes
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads (banners at the top of the shop): everyone reads, admin writes
    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GST report figures per taxable period (input tax etc.): admin only
    match /gstPeriods/{id} {
      allow read, write: if isAdmin();
    }

    // Customer profiles: the customer and admins
    match /customers/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Orders
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Customers create their own order, always starting at "awaiting_payment"
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'awaiting_payment'
        && request.resource.data.id == id;
      // Customers may only move their order to "payment_submitted" (after uploading a receipt).
      // Everything else (confirm payment, preparing, delivery, cancel) is admin only.
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['awaiting_payment', 'payment_rejected']
        && request.resource.data.status == 'payment_submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'receiptAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Transfer receipts (image or small PDF), one per order
    match /receipts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(id)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ================= DAY END SHEET (/eod) =================
    // Kept apart from the shop: its own staff list and its own reports.
    // eodStaff/{uid}: { role: "admin" | "staff", name }
    function isEodStaff() {
      return signedIn() && exists(/databases/$(database)/documents/eodStaff/$(request.auth.uid));
    }
    function isEodAdmin() {
      return isEodStaff() && get(/databases/$(database)/documents/eodStaff/$(request.auth.uid)).data.role == 'admin';
    }
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    // Today's date in the Maldives (UTC+5)
    function todayId() {
      let t = request.time + duration.value(5, 'h');
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }
    match /eodStaff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isEodAdmin());
      allow write: if isEodAdmin();
    }
    // One report per day, id = YYYY-MM-DD. Staff: today only. EOD admins: any day.
    match /eodReports/{date} {
      allow read: if isEodStaff();
      allow create, update: if isEodStaff()
        && request.resource.data.date == date
        && (isEodAdmin() || date == todayId());
      allow delete: if isEodAdmin();
    }
  }
}
